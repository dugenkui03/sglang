{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "detail": {
      "()": "sglang.srt.utils.common.DebugLogFormatter"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "formatter": "detail",
      "stream": "ext://sys.stderr"
    }
  },
  "loggers": {
    "httpx": {"level": "WARNING"},
    "httpcore": {"level": "WARNING"}
  },
  "root": {
    "level": "INFO",
    "handlers": ["console"]
  }
}
